[Unit]
Description=Tracklite release %i
After=postgresql.service

[Service]
Type=simple
User=tracklite
WorkingDirectory=/srv/tracklite/releases/%i
EnvironmentFile=/etc/tracklite/env
EnvironmentFile=/srv/tracklite/releases/%i/release.env
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
ExecStart=/srv/tracklite/releases/%i/node_modules/.bin/next start --hostname 127.0.0.1
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
StandardOutput=journal
StandardError=journal
