{
	log default {
		format filter {
			wrap json
			fields {
				request>uri regexp [?].*$ ""
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>proto delete
				request>host delete
				request>headers delete
				request>tls delete
			}
		}
	}
}

(live_app) {
	@port3001 file {
		root /srv/tracklite/current
		try_files /port-3001
	}
	handle @port3001 {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:3002
	}
}

{$TRACKLITE_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	@static {
		path_regexp static ^/_next/(static/.+)$
		query dpl=*
	}
	handle @static {
		@release file {
			root /srv/tracklite/releases
			try_files /{query.dpl}/.next/{re.static.1}
		}
		handle @release {
			root * /srv/tracklite/releases
			rewrite * {file_match.relative}
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			import live_app
		}
	}
	handle {
		import live_app
	}
}
